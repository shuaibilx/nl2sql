# Database
DB_META_HOST=localhost
DB_META_PORT=3306
DB_META_USER=atguigu
DB_META_PASSWORD=
DB_META_DATABASE=meta

DB_DW_HOST=localhost
DB_DW_PORT=3306
DB_DW_USER=atguigu
DB_DW_PASSWORD=
DB_DW_DATABASE=dw

MYSQL_ROOT_PASSWORD=
MYSQL_USER=atguigu
MYSQL_PASSWORD=

# Vector, search, and embedding services
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_EMBEDDING_SIZE=1024

EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

ES_HOST=localhost
ES_PORT=9200
ES_INDEX_NAME=data_agent

# LLM
LLM_MODEL_NAME=mimo-v2.5
LLM_API_KEY=
LLM_BASE_URL=https://api.xiaomimimo.com/v1

LLM_FALLBACK_MODEL_NAME=deepseek-v4-flash
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_BASE_URL=https://api.deepseek.com

# Cache
CACHE_BACKEND=redis
CACHE_ENV=dev
CACHE_KEY_PREFIX=nl2sql
CACHE_FAIL_FAST=false
CACHE_STALE_TTL_SECONDS=1800
CACHE_SEMANTIC_ENABLED=true
CACHE_SEMANTIC_THRESHOLD=0.94
CACHE_SEMANTIC_MAX_ENTRIES=1024
CACHE_SEMANTIC_TTL_SECONDS=7200
CACHE_TTL_EMBEDDING_SECONDS=86400
CACHE_TTL_LLM_CLEANUP_SECONDS=7200
CACHE_TTL_LLM_EXPAND_SECONDS=7200
CACHE_TTL_QDRANT_COLUMN_SECONDS=3600
CACHE_TTL_QDRANT_METRIC_SECONDS=3600
CACHE_TTL_ES_VALUE_SECONDS=3600
CACHE_TTL_GENERATE_SQL_SECONDS=7200
CACHE_TTL_META_MYSQL_SECONDS=7200
PROMPT_VERSION=v1
SCHEMA_VERSION=v1
EMBEDDING_MODEL_VERSION=bge-large-zh-v1.5
INDEX_VERSION=v1

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_SOCKET_TIMEOUT=3.0

# LangGraph checkpoint
CHECKPOINT_BACKEND=postgres
CHECKPOINT_POSTGRES_DSN=postgresql://nl2sql:nl2sql@localhost:5432/nl2sql_checkpoint
CHECKPOINT_POSTGRES_DB=nl2sql_checkpoint
CHECKPOINT_POSTGRES_USER=nl2sql
CHECKPOINT_POSTGRES_PASSWORD=nl2sql
CHECKPOINT_POOL_MIN_SIZE=1
CHECKPOINT_POOL_MAX_SIZE=10
CHECKPOINT_SETUP_ON_START=true
CHECKPOINT_RETENTION_DAYS=30
CHECKPOINT_SQLITE_PATH=checkpoints/checkpoint.db
LANGGRAPH_STRICT_MSGPACK=true

# Recall thresholds
RECALL_COLUMN_SCORE_THRESHOLD=0.7
RECALL_METRIC_SCORE_THRESHOLD=0.7
RECALL_VALUE_SCORE_THRESHOLD=1.0

# Monitoring
PROMETHEUS_ENABLED=true

# Optional LangSmith tracing
LANGSMITH_TRACING=false
# Set LangSmith API key in your local .env when tracing is enabled.
LANGSMITH_PROJECT=nl2sql
