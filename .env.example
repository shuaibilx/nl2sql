DB_DW_HOST=localhost
DB_DW_PORT=3306
DB_DW_USER=atguigu
DB_DW_PASSWORD=
DB_DW_DATABASE=dw

MYSQL_ROOT_PASSWORD=
MYSQL_USER=atguigu
