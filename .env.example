# Vector, search, and embedding services
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_EMBEDDING_SIZE=1024

EMBEDDING_HOST=localhost
EMBEDDING_PORT=8081
EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5

ES_HOST=localhost
ES_PORT=9200
ES_INDEX_NAME=data_agent

# LLM
LLM_MODEL_NAME=mimo-v2.5
LLM_API_KEY=
